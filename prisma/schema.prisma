// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  displayName   String?   @map("display_name") @db.VarChar(100)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  role          UserRole  @default(VIEWER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  
  articles      Article[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@map("users")
}

enum UserRole {
  ADMIN   @map("admin")
  EDITOR  @map("editor")
  VIEWER  @map("viewer")

  @@map("user_role")
}

// 文章表
model Article {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(255)
  description String?        @db.Text
  content     String         @db.LongText
  coverImage  String?        @map("cover_image") @db.VarChar(500)
  authorId    Int?           @map("author_id")
  viewCount   Int            @default(0) @map("view_count")
  starCount   Int            @default(0) @map("star_count")
  status      ArticleStatus  @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  publishedAt DateTime?      @map("published_at")
  
  author      User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags        ArticleTag[]
  techStack   ArticleTechStack[]
  links       ArticleLink[]

  @@index([status])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([authorId])
  @@map("articles")
}

enum ArticleStatus {
  DRAFT      @map("draft")
  PUBLISHED  @map("published")
  ARCHIVED   @map("archived")

  @@map("article_status")
}

// 标签表
model Tag {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(50)
  slug        String       @unique @db.VarChar(50)
  color       String?      @db.VarChar(20)
  icon        String?      @db.VarChar(50)
  description String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  
  articles    ArticleTag[]

  @@index([slug])
  @@index([name])
  @@map("tags")
}

// 文章-标签关联表
model ArticleTag {
  articleId Int      @map("article_id")
  tagId     Int      @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")
  
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

// 技术栈表
model TechStack {
  id          Int                @id @default(autoincrement())
  name        String             @unique @db.VarChar(50)
  icon        String?            @db.VarChar(50)
  link        String?            @db.VarChar(500)
  description String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  
  articles    ArticleTechStack[]

  @@index([name])
  @@map("tech_stack")
}

// 文章-技术栈关联表
model ArticleTechStack {
  articleId Int       @map("article_id")
  techId    Int       @map("tech_id")
  createdAt DateTime  @default(now()) @map("created_at")
  
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tech      TechStack @relation(fields: [techId], references: [id], onDelete: Cascade)

  @@id([articleId, techId])
  @@map("article_tech_stack")
}

// 文章链接表
model ArticleLink {
  id        Int         @id @default(autoincrement())
  articleId Int         @map("article_id")
  title     String?     @db.VarChar(100)
  url       String      @db.VarChar(500)
  icon      String?     @db.VarChar(50)
  linkType  LinkType    @default(OTHER) @map("link_type")
  createdAt DateTime    @default(now()) @map("created_at")
  
  article   Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_links")
}

enum LinkType {
  GITHUB @map("github")
  DEMO   @map("demo")
  DOCS   @map("docs")
  OTHER  @map("other")

  @@map("link_type")
}
