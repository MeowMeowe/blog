{
    "name": "blog",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@10.12.4",
    "engines": {
        "node": ">=20 <23",
        "pnpm": ">=9"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "admin:create": "node --env-file=.env scripts/create-admin.mjs",
        "assets:stats": "node scripts/generate-stats-icons.mjs",
        "content:seed": "node scripts/generate-seed.mjs",
        "content:sync": "node --env-file=.env scripts/sync-content.mjs",
        "content:sync-one": "node --env-file=.env scripts/sync-article.mjs",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.mjs",
        "db:migrate": "node --env-file=.env scripts/migrate.mjs",
        "db:backup": "node --env-file=.env scripts/database-backup.mjs",
        "db:restore": "node --env-file=.env scripts/database-restore.mjs",
        "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
        "prepare": "husky install"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@reduxjs/toolkit": "^2.11.2",
        "bcryptjs": "^3.0.3",
        "next": "16.4.2",
        "next-auth": "^4.24.15",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-redux": "^9.3.0",
        "redux": "^5.0.1",
        "sanitize-html": "2.18.1",
        "sharp": "0.35.5",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@commitlint/cli": "^17.8.1",
        "@commitlint/config-conventional": "^17.8.1",
        "@types/node": "^20.11.24",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/sanitize-html": "2.16.1",
        "cross-env": "^7.0.3",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.2",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^8.0.3",
        "prettier": "^3.6.2",
        "prisma": "^5.22.0",
        "sass-embedded": "1.105.2",
        "typescript": "^5.9.3"
    }
}
