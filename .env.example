# Environment Variables
# Copy this file to .env and fill in your actual values

# Local MySQL (used by Docker Compose)
MYSQL_ROOT_PASSWORD="replace-with-a-long-random-root-password"
MYSQL_DATABASE="blog"
MYSQL_USER="blog_user"
MYSQL_PASSWORD="replace-with-a-long-random-app-password"
MYSQL_PORT="3306"

# Prisma
DATABASE_URL="mysql://blog_user:replace-with-a-long-random-app-password@127.0.0.1:3306/blog"

# NextAuth.js
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
# Persistent media directory; include it in server backups.
MEDIA_ROOT=".storage/media"
# Use one hard-to-guess path segment; do not use /admin or publish it in robots/sitemap.
ADMIN_PATH="/backstage-change-this-random-path"

# Local administrator bootstrap (do not reuse in production)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-16-random-characters"
ADMIN_USERNAME="admin"
ADMIN_DISPLAY_NAME="Administrator"

# Optional: For production
# NEXTAUTH_URL="https://yourdomain.com"
